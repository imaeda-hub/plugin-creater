{
  "about": "eval.json の1課題の形と採点のしかたの決まりを、1段目（template/tests/stage1/check_structure.py の check_eval）と採点（skills/test-plugin/scripts/grade.mjs の validateTask）の両方に通す例。ok が true の例は両方が通し、false の例は両方が断る。2つがずれると、test_check_structure.py（Python）と eval-parity.test.mjs（Node）のどちらかが落ちる。課題は base に top と criterion を重ねて作る。値が \"$remove\" の項目は消す。criterion は1つ目の基準（C-01）に重ねる。needsNode が true の例は、Python 側では node がないと確かめない。",
  "base": {
    "id": "T-01",
    "prompt": "題材は天気で、見本を作って",
    "inputs": ["inputs/memo.txt"],
    "settings": { "maxIterations": 3 },
    "criteria": [
      {
        "id": "C-01",
        "text": "成果物に題がある",
        "grading": "program",
        "check": { "type": "contains", "file": "out/*.md", "text": "# " }
      }
    ]
  },
  "cases": [
    { "name": "contains の基準は通る", "ok": true },
    { "name": "file_exists の基準は通る", "ok": true, "criterion": { "check": { "type": "file_exists", "file": "out/report.md" } } },
    { "name": "not_contains の基準は通る", "ok": true, "criterion": { "check": { "type": "not_contains", "file": "out/**/*.md", "text": "TODO" } } },
    { "name": "regex の基準は通る（flags つき）", "ok": true, "needsNode": true, "criterion": { "check": { "type": "regex", "file": "out/*.md", "pattern": "^# .+", "flags": "im" } } },
    { "name": "regex の基準は通る（flags なし）", "ok": true, "needsNode": true, "criterion": { "check": { "type": "regex", "file": "out/*.md", "pattern": "\\d{4}-W\\d{2}" } } },
    { "name": "グロブの {} と [] と ? は通る", "ok": true, "criterion": { "check": { "type": "file_exists", "file": "out/report-[0-9]?.{md,txt}" } } },
    { "name": "model の基準は check がなくても通る", "ok": true, "criterion": { "grading": "model", "check": "$remove" } },
    { "name": "model の基準は check.files があれば通る", "ok": true, "criterion": { "grading": "model", "check": { "files": ["out/**/*.md", "out/*.txt"] } } },
    { "name": "課題の上限の回数 1 は通る", "ok": true, "top": { "settings": { "maxIterations": 1 } } },
    { "name": "課題の上限の回数が 3.0 でも整数として通る", "ok": true, "top": { "settings": { "maxIterations": 3.0 } } },
    { "name": "inputs や settings を省いても通る", "ok": true, "top": { "inputs": "$remove", "settings": "$remove" } },

    { "name": "check.type が includes（使えない種類）", "ok": false, "criterion": { "check": { "type": "includes", "file": "out/*.md", "text": "# " } } },
    { "name": "check.type がない", "ok": false, "criterion": { "check": { "file": "out/*.md", "text": "# " } } },
    { "name": "program なのに check がない", "ok": false, "criterion": { "check": "$remove" } },
    { "name": "program なのに check が null", "ok": false, "criterion": { "check": null } },
    { "name": "program なのに check が文字", "ok": false, "criterion": { "check": "contains" } },
    { "name": "contains に text がない", "ok": false, "criterion": { "check": { "type": "contains", "file": "out/*.md" } } },
    { "name": "contains の text が空白だけ", "ok": false, "criterion": { "check": { "type": "contains", "file": "out/*.md", "text": "  " } } },
    { "name": "contains の text が数", "ok": false, "criterion": { "check": { "type": "contains", "file": "out/*.md", "text": 5 } } },
    { "name": "contains に使わない項目 pattern がある", "ok": false, "criterion": { "check": { "type": "contains", "file": "out/*.md", "text": "# ", "pattern": "x" } } },
    { "name": "file_exists に使わない項目 text がある", "ok": false, "criterion": { "check": { "type": "file_exists", "file": "out/*.md", "text": "x" } } },
    { "name": "file がない", "ok": false, "criterion": { "check": { "type": "file_exists" } } },
    { "name": "file が空", "ok": false, "criterion": { "check": { "type": "file_exists", "file": "" } } },
    { "name": "file が文字でない", "ok": false, "criterion": { "check": { "type": "file_exists", "file": ["out/a.md"] } } },
    { "name": "file が絶対の場所", "ok": false, "criterion": { "check": { "type": "file_exists", "file": "/etc/passwd" } } },
    { "name": "file が Windows の絶対の場所", "ok": false, "criterion": { "check": { "type": "file_exists", "file": "C:/out/report.md" } } },
    { "name": "file に .. がある", "ok": false, "criterion": { "check": { "type": "file_exists", "file": "../out/report.md" } } },
    { "name": "file の途中に .. がある", "ok": false, "criterion": { "check": { "type": "file_exists", "file": "out/../../report.md" } } },
    { "name": "file の区切りが \\", "ok": false, "criterion": { "check": { "type": "file_exists", "file": "out\\report.md" } } },
    { "name": "file のグロブが読めない（範囲が逆）", "ok": false, "criterion": { "check": { "type": "file_exists", "file": "out/[z-a].md" } } },
    { "name": "regex に pattern がない", "ok": false, "criterion": { "check": { "type": "regex", "file": "out/*.md" } } },
    { "name": "regex の pattern が空白だけ", "ok": false, "criterion": { "check": { "type": "regex", "file": "out/*.md", "pattern": " " } } },
    { "name": "regex の flags に使えない g", "ok": false, "criterion": { "check": { "type": "regex", "file": "out/*.md", "pattern": "x", "flags": "g" } } },
    { "name": "regex の flags が重なっている", "ok": false, "criterion": { "check": { "type": "regex", "file": "out/*.md", "pattern": "x", "flags": "ii" } } },
    { "name": "regex の flags が文字でない", "ok": false, "criterion": { "check": { "type": "regex", "file": "out/*.md", "pattern": "x", "flags": 5 } } },
    { "name": "regex の pattern が正規表現として読めない", "ok": false, "needsNode": true, "criterion": { "check": { "type": "regex", "file": "out/*.md", "pattern": "(" } } },
    { "name": "regex の pattern に text を使っている", "ok": false, "criterion": { "check": { "type": "regex", "file": "out/*.md", "text": "x" } } },
    { "name": "model の check が文字", "ok": false, "criterion": { "grading": "model", "check": "files" } },
    { "name": "model の check に使わない項目 type がある", "ok": false, "criterion": { "grading": "model", "check": { "type": "contains", "files": ["out/*.md"] } } },
    { "name": "model の check.files が空", "ok": false, "criterion": { "grading": "model", "check": { "files": [] } } },
    { "name": "model の check.files が文字（並びでない）", "ok": false, "criterion": { "grading": "model", "check": { "files": "out/*.md" } } },
    { "name": "model の check.files に .. がある", "ok": false, "criterion": { "grading": "model", "check": { "files": ["../x"] } } },
    { "name": "grading が human", "ok": false, "criterion": { "grading": "human" } },
    { "name": "grading がない", "ok": false, "criterion": { "grading": "$remove" } },
    { "name": "基準の id が空白", "ok": false, "criterion": { "id": " " } },
    { "name": "基準の text がない", "ok": false, "criterion": { "text": "$remove" } },
    { "name": "基準の id が重なっている", "ok": false, "top": { "criteria": [
      { "id": "C-01", "text": "成果物に題がある", "grading": "model" },
      { "id": "C-01", "text": "成果物に題がある", "grading": "model" }
    ] } },
    { "name": "criteria が空", "ok": false, "top": { "criteria": [] } },
    { "name": "criteria が並びでない", "ok": false, "top": { "criteria": "C-01" } },
    { "name": "criteria がない", "ok": false, "top": { "criteria": "$remove" } },
    { "name": "criteria の要素がオブジェクトでない", "ok": false, "top": { "criteria": ["C-01"] } },
    { "name": "課題の id がない", "ok": false, "top": { "id": "$remove" } },
    { "name": "課題の prompt が空白だけ", "ok": false, "top": { "prompt": "  " } },
    { "name": "inputs が並びでない", "ok": false, "top": { "inputs": "inputs/memo.txt" } },
    { "name": "inputs が絶対の場所", "ok": false, "top": { "inputs": ["/etc/passwd"] } },
    { "name": "inputs に .. がある", "ok": false, "top": { "inputs": ["../outside.txt"] } },
    { "name": "inputs の区切りが \\ でも .. は見つける", "ok": false, "top": { "inputs": ["inputs\\..\\..\\outside.txt"] } },
    { "name": "inputs の要素が数", "ok": false, "top": { "inputs": [5] } },
    { "name": "settings がオブジェクトでない", "ok": false, "top": { "settings": 3 } },
    { "name": "settings.maxIterations が 0", "ok": false, "top": { "settings": { "maxIterations": 0 } } },
    { "name": "settings.maxIterations が文字", "ok": false, "top": { "settings": { "maxIterations": "3" } } },
    { "name": "settings.maxIterations が小数", "ok": false, "top": { "settings": { "maxIterations": 1.5 } } },
    { "name": "settings.maxIterations が真偽", "ok": false, "top": { "settings": { "maxIterations": true } } },
    { "name": "settings.task がオブジェクトでない", "ok": false, "top": { "settings": { "maxIterations": 3, "task": ["topic"] } } },
    { "name": "settings.task の値が null", "ok": false, "top": { "settings": { "maxIterations": 3, "task": { "topic": null } } } },
    { "name": "settings.task の値が並び", "ok": false, "top": { "settings": { "maxIterations": 3, "task": { "topic": ["天気"] } } } }
  ]
}
